local espCache = {}

local function removeDrawingESP(p)
   if espCache[p] then
      for _, obj in pairs(espCache[p]) do
         pcall(function() obj:Remove() end)
      end
      espCache[p] = nil
   end
end

RunService.RenderStepped:Connect(function()
   local rainbowColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)

   for _, p in ipairs(Players:GetPlayers()) do
      if p ~= player then
         local char = p.Character
         local rootPart = char and char:FindFirstChild("HumanoidRootPart")
         local hum = char and char:FindFirstChildOfClass("Humanoid")

         if char and rootPart and hum and hum.Health > 0 and (espBoxEnabled or espNameEnabled or espHealthEnabled or espDistanceEnabled or espTracerEnabled) then
            
            if not espCache[p] then
               local box = Drawing.new("Square")
               box.Visible = false
               box.Thickness = 1.5
               box.Filled = false

               local nameTag = Drawing.new("Text")
               nameTag.Visible = false
               nameTag.Size = 14
               nameTag.Center = true
               nameTag.Outline = true

               local healthBarBg = Drawing.new("Square")
               healthBarBg.Visible = false
               healthBarBg.Filled = true
               healthBarBg.Color = Color3.fromRGB(0, 0, 0)

               local healthBar = Drawing.new("Square")
               healthBar.Visible = false
               healthBar.Filled = true

               local tracer = Drawing.new("Line")
               tracer.Visible = false
               tracer.Thickness = 1.5

               espCache[p] = {Box = box, Text = nameTag, HealthBarBg = healthBarBg, HealthBar = healthBar, Tracer = tracer}
            end

            local cache = espCache[p]
            local box = cache.Box
            local nameTag = cache.Text
            local healthBarBg = cache.HealthBarBg
            local healthBar = cache.HealthBar
            local tracer = cache.Tracer

            box.Color = rainbowColor
            nameTag.Color = rainbowColor
            tracer.Color = rainbowColor

            local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            if onScreen then
               local head = char:FindFirstChild("Head")
               local topPosition = head and head.Position + Vector3.new(0, 0.6, 0) or rootPart.Position + Vector3.new(0, 2.2, 0)
               local legPosition = rootPart.Position - Vector3.new(0, 3, 0)

               local topVector = Camera:WorldToViewportPoint(topPosition)
               local legVector = Camera:WorldToViewportPoint(legPosition)

               local height = math.abs(topVector.Y - legVector.Y)
               local width = height / 2

               if espBoxEnabled then
                  box.Size = Vector2.new(width, height)
                  box.Position = Vector2.new(topVector.X - width / 2, topVector.Y)
                  box.Visible = true
               else
                  box.Visible = false
               end

               if espNameEnabled or espDistanceEnabled then
                  local textStr = ""
                  if espNameEnabled then textStr = textStr .. "👤 " .. p.Name end
                  if espDistanceEnabled then
                     local dist = math.floor((rootPart.Position - Camera.CFrame.Position).Magnitude)
                     textStr = textStr .. " [" .. dist .. "m]"
                  end
                  nameTag.Text = textStr
                  nameTag.Position = Vector2.new(topVector.X, topVector.Y - 18)
                  nameTag.Visible = true
               else
                  nameTag.Visible = false
               end

               if espHealthEnabled then
                  local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                  local barHeight = height * healthPercent
                  
                  healthBarBg.Size = Vector2.new(3, height + 2)
                  healthBarBg.Position = Vector2.new(topVector.X - width / 2 - 6, topVector.Y - 1)
                  healthBarBg.Visible = true

                  healthBar.Size = Vector2.new(1, barHeight)
                  healthBar.Position = Vector2.new(topVector.X - width / 2 - 5, topVector.Y + (height - barHeight))
                  healthBar.Color = Color3.fromRGB(255 - (healthPercent * 255), healthPercent * 255, 0)
                  healthBar.Visible = true
               else
                  healthBarBg.Visible = false
                  healthBar.Visible = false
               end

               if espTracerEnabled then
                  tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                  tracer.To = Vector2.new(vector.X, vector.Y)
                  tracer.Visible = true
               else
                  tracer.Visible = false
               end

            else
               box.Visible = false
               nameTag.Visible = false
               healthBarBg.Visible = false
               healthBar.Visible = false
               tracer.Visible = false
            end
         else
            removeDrawingESP(p)
         end
      end
   end
end)

Players.PlayerRemoving:Connect(function(p)
   removeDrawingESP(p)
end)

