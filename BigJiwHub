BoostTab:CreateToggle({
   Name = "🚀 เปิด/ปิด โหมดเร่งความลื่น (FPS Booster)",
   CurrentValue = false,
   Callback = function(Value)
      if Value then
         Lighting.GlobalShadows = false
         for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
               v.Material = Enum.Material.SmoothPlastic
               v.Reflectance = 0
            elseif v:IsA("Decal") or v:IsA("Texture") then
               v.Transparency = 1
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
               v.Enabled = false
            end
         end
      else
         Lighting.GlobalShadows = true
      end
   end,
})

local fpsConnection = nil
local fpsTextLabel = nil

BoostTab:CreateToggle({
   Name = "📊 เปิดหน้าต่างแสดง FPS & Ping",
   CurrentValue = false,
   Callback = function(Value)
      if Value then
         if player.PlayerGui:FindFirstChild("FpsPingGuiCustom") then
            player.PlayerGui.FpsPingGuiCustom:Destroy()
         end

         local screenGui = Instance.new("ScreenGui", player.PlayerGui)
         screenGui.Name = "FpsPingGuiCustom"
         screenGui.ResetOnSpawn = false

         local frame = Instance.new("Frame", screenGui)
         frame.Size = UDim2.new(0, 160, 0, 50)
         frame.Position = UDim2.new(0.85, 0, 0.05, 0)
         frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
         frame.BorderSizePixel = 0
         frame.Active = true
         frame.Draggable = true

         fpsTextLabel = Instance.new("TextLabel", frame)
         fpsTextLabel.Size = UDim2.new(1, 0, 1, 0)
         fpsTextLabel.BackgroundTransparency = 1
         fpsTextLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
         fpsTextLabel.TextSize = 14
         fpsTextLabel.Font = Enum.Font.SourceSansBold
         fpsTextLabel.Text = "FPS: ... | Ping: ..."

         local lastUpdate = tick()
         local frameCount = 0

         fpsConnection = RunService.RenderStepped:Connect(function()
            frameCount = frameCount + 1
            local now = tick()
            if now - lastUpdate >= 0.5 then
               local fps = math.floor(frameCount / (now - lastUpdate))
               local ping = 0
               pcall(function()
                  ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
               end)
               if fpsTextLabel and fpsTextLabel.Parent then
                  fpsTextLabel.Text = string.format("📊 FPS: %d | Ping: %d ms", fps, ping)
               end
               frameCount = 0
               lastUpdate = now
            end
         end)
      else
         if fpsConnection then
            fpsConnection:Disconnect()
            fpsConnection = nil
         end
         if player.PlayerGui:FindFirstChild("FpsPingGuiCustom") then
            player.PlayerGui.FpsPingGuiCustom:Destroy()
         end
      end
   end,
})

